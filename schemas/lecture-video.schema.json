{
  "schemaVersion": 1,
  "lecturePackage": {
    "required": [
      "schemaVersion",
      "packageId",
      "title",
      "subjectOwnedAssetRoot",
      "contentSource",
      "objectiveIds",
      "durationSeconds",
      "lessonMode",
      "deliveryPlan",
      "performancePlan",
      "renderStatus",
      "generatedInstructor",
      "sourceReview",
      "citations",
      "script",
      "storyboard",
      "transcript",
      "captions",
      "chapters",
      "slides",
      "media",
      "licenseAudit",
      "qaStatus",
      "operatorReview",
      "adaptiveHooks"
    ]
  },
  "definitions": {
    "contentSource": {
      "required": [
        "sourceId",
        "sourceRepo",
        "sourcePath",
        "title"
      ]
    },
    "generatedInstructor": {
      "required": [
        "personaId",
        "gender",
        "disclosure",
        "voiceConsent",
        "likenessConsent",
        "realPersonClone",
        "voiceMatchPolicy",
        "tone",
        "realismProfile"
      ]
    },
    "instructorRealismProfile": {
      "required": [
        "presentationStyle",
        "renderReadiness",
        "visualFidelityTargets",
        "movementPlan",
        "boardInteractionPlan"
      ]
    },
    "deliveryPlan": {
      "required": [
        "audienceMode",
        "baselineUse",
        "adaptiveUse",
        "fullLectureDuration",
        "segmentCadence",
        "learningEnvironmentPrompts",
        "adaptationRequirements",
        "boardPlan"
      ]
    },
    "fullLectureDuration": {
      "required": [
        "targetSeconds",
        "minimumSeconds",
        "maximumSeconds",
        "rationale"
      ]
    },
    "segmentCadence": {
      "required": [
        "minimumSegmentSeconds",
        "maximumSegmentSeconds",
        "checkpointEverySeconds",
        "practiceEverySeconds"
      ]
    },
    "boardPlan": {
      "required": [
        "defaultView",
        "closeUpAvailable",
        "closeUpLabel",
        "moments"
      ]
    },
    "boardMoment": {
      "required": [
        "timeSecond",
        "label",
        "summary"
      ]
    },
    "performancePlan": {
      "required": [
        "audioProfile",
        "pausePrompts",
        "visualSync"
      ]
    },
    "audioProfile": {
      "required": [
        "voiceStyle",
        "voiceMatchPolicy",
        "targetInstructorGender",
        "targetVoiceGender",
        "targetVoiceRegister",
        "emotionTargets",
        "prosodyDirectives",
        "ttsRequirements"
      ]
    },
    "pausePrompt": {
      "required": [
        "promptId",
        "timeSecond",
        "durationSeconds",
        "prompt",
        "overlayText",
        "resumeCue",
        "boardState"
      ]
    },
    "visualSync": {
      "required": [
        "boardStates",
        "minimumBoardStateCoverage",
        "staticFramePolicy"
      ]
    },
    "boardState": {
      "required": [
        "stateId",
        "startSecond",
        "endSecond",
        "boardText",
        "instructorAction"
      ]
    },
    "sourceReview": {
      "required": [
        "sourceType",
        "title",
        "usedFor",
        "copyingAllowed"
      ]
    },
    "citation": {
      "required": [
        "citationId",
        "sourceId",
        "sourceRepo",
        "sourcePath",
        "claim"
      ]
    },
    "storyboardScene": {
      "required": [
        "sceneId",
        "startSecond",
        "endSecond",
        "visual",
        "narrationCue",
        "citationIds"
      ]
    },
    "captionTrack": {
      "required": [
        "format",
        "language",
        "text"
      ]
    },
    "slideAsset": {
      "required": [
        "slideId",
        "title",
        "path",
        "altText",
        "attribution"
      ]
    },
    "mediaAsset": {
      "required": [
        "assetId",
        "type",
        "path",
        "sha256",
        "status",
        "requiredForPublish"
      ],
      "statusValues": [
        "planned",
        "rendered",
        "archived"
      ]
    },
    "licenseAudit": {
      "required": [
        "status",
        "externalHostDependency",
        "requiredInstructionArchive",
        "blockedMaterials"
      ]
    },
    "qaStatus": {
      "required": [
        "status",
        "checks"
      ],
      "requiredChecks": [
        "source-grounding",
        "license-safety",
        "accessibility",
        "active-recall",
        "assessment-handoff"
      ]
    },
    "operatorReview": {
      "required": [
        "workflowId",
        "publishStatus",
        "stages",
        "finalApproval"
      ],
      "requiredStages": [
        "script",
        "visuals",
        "media",
        "accessibility",
        "license-persona",
        "instructor-realism",
        "final-package"
      ],
      "allowedStatuses": [
        "pending",
        "approved",
        "changes-requested",
        "rejected"
      ],
      "allowedPublishStatuses": [
        "not-ready",
        "approved-for-publish",
        "changes-requested",
        "rejected"
      ]
    },
    "adaptiveHooks": {
      "required": [
        "availableModes",
        "checkpointPolicy",
        "checkpoints",
        "followUpAction"
      ]
    }
  }
}
