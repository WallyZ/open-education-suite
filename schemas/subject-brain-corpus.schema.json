{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-education.local/schemas/subject-brain-corpus.schema.json",
  "title": "Open Education Subject Brain Corpus Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brainId", "updatedAt", "sources"],
  "properties": {
    "schemaVersion": { "const": "open-education/subject-brain-corpus/v1" },
    "brainId": { "type": "string" },
    "updatedAt": { "type": "string", "format": "date" },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "title", "sourceType", "canonicalUrl", "alternateUrls", "gradeBands", "topics", "evidenceTier", "rights", "acquisition"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "title": { "type": "string" },
          "sourceType": { "enum": ["book", "textbook", "primary-source", "reference", "paper", "practice-guide", "dataset", "website", "repo-policy", "media-transcript", "code", "image", "audiovisual", "equation-set"] },
          "canonicalUrl": { "type": "string" },
          "alternateUrls": { "type": "array", "items": { "type": "string" } },
          "localPath": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "gradeBands": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "topics": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "locatorPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "preferredKinds": {
                "type": "array",
                "uniqueItems": true,
                "items": { "enum": ["page", "chapter", "section", "verse", "equation", "table", "diagram", "code-symbol", "dataset", "image", "audiovisual-timestamp"] }
              },
              "notes": { "type": "string" }
            }
          },
          "evidenceTier": { "type": "string" },
          "rights": {
            "type": "object",
            "required": ["licenseId", "licenseUrl", "rightsStatus", "notes"],
            "properties": {
              "licenseId": { "type": "string" },
              "licenseUrl": { "type": "string" },
              "rightsStatus": { "enum": ["approved-for-local-index", "metadata-only", "permission-required", "purchase-required", "excluded"] },
              "notes": { "type": "string" }
            }
          },
          "acquisition": {
            "type": "object",
            "required": ["status", "retrievedAt", "method", "notes"],
            "properties": {
              "status": { "enum": ["local-ready", "local-pending-extraction", "planned-download", "link-only", "permission-required", "purchase-required", "excluded"] },
              "retrievedAt": { "type": ["string", "null"] },
              "method": { "type": "string" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
