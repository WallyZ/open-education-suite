{
  "schemaVersion": 1,
  "workflowId": "lecture-operator-review-v1",
  "publishRule": "Every required review stage must be approved by an operator before a lecture package can be approved for publish.",
  "selfApprovalPolicy": "Generated systems, generated instructors, and automated checks cannot approve their own lecture packages.",
  "allowedStatuses": [
    "pending",
    "approved",
    "changes-requested",
    "rejected"
  ],
  "allowedPublishStatuses": [
    "not-ready",
    "approved-for-publish",
    "changes-requested",
    "rejected"
  ],
  "prohibitedReviewers": [
    "ai-system",
    "generated-instructor",
    "automation-only"
  ],
  "requiredStages": [
    {
      "stageId": "script",
      "label": "Generated script",
      "requiredEvidence": [
        "source citations",
        "original narration",
        "misconception checks",
        "assessment handoff"
      ]
    },
    {
      "stageId": "visuals",
      "label": "Slides and visual plan",
      "requiredEvidence": [
        "original or licensed visuals",
        "alt text",
        "no copied screenshots",
        "clear storyboard alignment",
        "board-content synchronization"
      ]
    },
    {
      "stageId": "media",
      "label": "Rendered media archive",
      "requiredEvidence": [
        "local archive path",
        "sha256 checksums",
        "required media rendered or archived",
        "no host-only dependencies",
        "audio naturalness check",
        "board-local pause prompt timing"
      ]
    },
    {
      "stageId": "accessibility",
      "label": "Accessibility package",
      "requiredEvidence": [
        "captions",
        "transcript",
        "chapters",
        "slide alt text"
      ]
    },
    {
      "stageId": "license-persona",
      "label": "License and generated instructor persona",
      "requiredEvidence": [
        "license gate pass",
        "persona disclosure",
        "voice consent",
        "likeness consent"
      ]
    },
    {
      "stageId": "instructor-realism",
      "label": "Generated instructor realism",
      "requiredEvidence": [
        "face/body consistency",
        "front-row framing",
        "board readability",
        "board occlusion check",
        "board close-up usefulness",
        "gesture timing",
        "lip-sync timing",
        "gaze direction",
        "head and hand motion naturalness",
        "board-writing gesture synchronization",
        "no whole-frame teaching text overlays",
        "generated instructor disclosure",
        "human emotional delivery check"
      ]
    },
    {
      "stageId": "final-package",
      "label": "Final publish package",
      "requiredEvidence": [
        "all required stages approved",
        "quality rubric passed",
        "content source linked",
        "operator final approval",
        "learner usefulness review"
      ]
    }
  ]
}
